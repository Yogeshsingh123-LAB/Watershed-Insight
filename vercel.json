{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "api": {
      "root": ".",
      "entrypoint": "api/index.py"
    }
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/docs",
      "destination": { "service": "api" }
    },
    {
      "source": "/openapi.json",
      "destination": { "service": "api" }
    },
    {
      "source": "/static/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
