# ---------------------------------------------------------------------------
# Watershed Insight - runtime configuration (copy to .env and edit)
# ---------------------------------------------------------------------------

# Where the watershed dataset lives (boundaries, DEM, satellite stacks, photos)
WS_DATA_DIR=./data/sample

# Where rendered map overlays are cached
WS_OUTPUT_DIR=./data/sample/overlays

# Where generated PDF evidence documents are written
WS_REPORTS_DIR=./reports/generated

# CORS: comma separated list, or * for local development
WS_CORS_ORIGINS=*

# --- analytical defaults ----------------------------------------------------
WS_BUFFER_M=250                 # default impact buffer radius (m)
WS_WATER_NDWI=0.10              # NDWI threshold for surface water
WS_VEG_NDVI=0.30                # NDVI threshold for vegetated cover
WS_STREAM_THRESHOLD=220         # flow-accumulation cells needed to form a stream
WS_PHOTO_BIND_RADIUS=250        # photo -> intervention binding radius (m)
WS_MAX_UPLOAD_MB=25
WS_OVERLAY_ALPHA=0.8

# Frontend: backend target for the Vite dev-server proxy
VITE_BACKEND_URL=http://127.0.0.1:8000
